{
  "name": "wa-auto",
  "version": "1.0.0",
  "private": true,
  "description": "Envio de mensagens a clientes a partir de Excel e CSV, com WhatsApp conectado por QR Code.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:browser": "node tests/browser.smoke.js",
    "check": "node scripts/check.js",
    "verify": "npm run check && npm test",
    "test:hosted": "node tests/browser.hosted.js"
  },
  "dependencies": {
    "csv-parse": "7.0.2",
    "exceljs": "4.4.0",
    "express": "5.2.1",
    "multer": "2.4.0",
    "qrcode": "1.5.4",
    "whatsapp-web.js": "1.34.7"
  }
}
