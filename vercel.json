{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["gru1"],
  "functions": {
    "api/djen-proxy.js": {
      "regions": ["gru1"],
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "https://wa-auto-cloud.onrender.com/",
      "permanent": false
    },
    {
      "source": "/processos",
      "destination": "https://wa-auto-cloud.onrender.com/processos",
      "permanent": false
    }
  ]
}