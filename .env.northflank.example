# Northflank / runtime persistente
PORT=10000
NODE_VERSION=22

# Persistência remota obrigatória
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
WA_DB_SECRET=troque-por-um-segredo-longo

# Configure depois que o Northflank gerar o domínio público
WA_PUBLIC_ORIGIN=https://SEU-SERVICO.northflank.app

# Limites seguros para o serviço gratuito
WA_MEMORY_LIMIT_MB=512
WA_MEMORY_PAUSE_MB=430
WA_MEMORY_RESUME_MB=360
WA_HISTORY_RETENTION_DAYS=30
WA_LEGAL_SEND_DELAY_MS=30000

# MCP permanece desligado por padrão
WA_MCP_ALLOW_SEND=0
WA_MCP_ALLOW_GROUPS=0
