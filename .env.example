# WA.Auto Cloud
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
WA_DB_SECRET=gere-um-segredo-longo-e-aleatorio
WA_PUBLIC_ORIGIN=https://SEU-WA-AUTO.onrender.com
WA_HISTORY_RETENTION_DAYS=30

# MCP remoto do WhatsApp
# Gere um segredo longo e não publique este valor.
WA_MCP_TOKEN=gere-um-token-com-pelo-menos-24-caracteres
# Leitura fica disponível com o token. Envio só é exposto quando explicitamente habilitado.
WA_MCP_ALLOW_SEND=0
# Grupos ficam fora da captura e das ferramentas por padrão.
WA_MCP_ALLOW_GROUPS=0

# Reconexão resiliente do Baileys
WA_RECONNECT_BASE_MS=2500
WA_RECONNECT_MAX_MS=60000
WA_RECONNECT_MAX_ATTEMPTS=8

# Integração direta com LexisPredict (pode reutilizar WA_MCP_TOKEN)
WA_INTEGRATION_TOKEN=gere-um-token-longo-e-aleatorio
