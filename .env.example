# WA.Auto Cloud
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
WA_DB_SECRET=gere-um-segredo-longo-e-aleatorio
WA_PUBLIC_ORIGIN=https://SEU-WA-AUTO.onrender.com
WA_HISTORY_RETENTION_DAYS=30

# MCP remoto do WhatsApp
# Gere um segredo longo e não publique este valor.
WA_MCP_TOKEN=gere-um-token-com-pelo-menos-24-caracteres
